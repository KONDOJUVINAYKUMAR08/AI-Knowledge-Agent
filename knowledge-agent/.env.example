# LLM configuration
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash
GOOGLE_API_KEY=replace-in-local-env-only
# OPENAI_API_KEY is required only when LLM_PROVIDER=openai.
# OPENAI_API_KEY=replace-in-local-env-only
# GROQ_API_KEY is required only when LLM_PROVIDER=groq.
# GROQ_API_KEY=replace-in-local-env-only

# Timeout and retry policy
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=2
LLM_RETRY_BACKOFF_SECONDS=0.5
AGENT_TOOL_TIMEOUT_SECONDS=30
AGENT_QUERY_TIMEOUT_SECONDS=90

# MCP Server
MCP_SERVER_URL=http://mcp-server:8001/mcp

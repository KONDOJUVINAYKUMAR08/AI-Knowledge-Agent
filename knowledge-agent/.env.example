# Knowledge Agent Environment Variables
# Copy this file to .env and fill in values

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
API_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# MCP Server path (absolute path to the mcp-server directory)
MCP_SERVER_SCRIPT_PATH=../mcp-server/src/server/main.py
MCP_SERVER_PYTHON=python

# Agent Settings
AGENT_MAX_TOOL_RETRIES=3
AGENT_TOOL_TIMEOUT_SECONDS=30

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json  # json | console
